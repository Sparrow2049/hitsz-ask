# Copy this to .env.local for local dev (never commit .env.local itself —
# .gitignore already blocks it). In production, set these in Vercel's
# Project Settings → Environment Variables instead.

# --- Turso (persistence on Vercel — see docs/decisions.md) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth.js / Google sign-in ---
# AUTH_SECRET: any long random string. Generate one with:
#   openssl rand -base64 33
AUTH_SECRET=
# From Google Cloud Console → APIs & Services → Credentials → OAuth
# client ID (Web application). Authorized redirect URI must be:
#   https://hitszask.site/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Admin allowlist ---
# Comma-separated Google account emails allowed to delete resources/
# questions. No spaces needed around commas, but they're trimmed if present.
ADMIN_EMAILS=
